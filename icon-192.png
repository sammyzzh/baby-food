<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#3B6D11">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="辅食管理">
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<title>宝宝辅食管理</title>
<style>
:root {
  --bg: #FAFAF8;
  --surface: #FFFFFF;
  --surface2: #F4F3EF;
  --border: rgba(0,0,0,0.08);
  --border2: rgba(0,0,0,0.15);
  --text: #1A1916;
  --text2: #6B6860;
  --text3: #9E9C97;
  --green: #3B6D11;
  --green-bg: #EAF3DE;
  --green-mid: #639922;
  --blue: #185FA5;
  --blue-bg: #E6F1FB;
  --amber: #854F0B;
  --amber-bg: #FAEEDA;
  --red: #A32D2D;
  --red-bg: #FCEBEB;
  --r: 12px;
  --rs: 8px;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-top: env(safe-area-inset-top, 0px);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1A1916;
    --surface: #242320;
    --surface2: #2E2C28;
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.15);
    --text: #F0EDE8;
    --text2: #A09C97;
    --text3: #6B6860;
    --green-bg: #1E3509;
    --blue-bg: #0C2340;
    --amber-bg: #2E1C06;
    --red-bg: #2E0A0A;
  }
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; overscroll-behavior: none; }
body {
  font-family: -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
  max-width: 480px;
  margin: 0 auto;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* ── Top bar ── */
.topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: calc(var(--safe-top) + 12px) 16px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}
.topbar-title { font-size: 17px; font-weight: 600; }
.topbar-sub { font-size: 12px; color: var(--text3); margin-top: 1px; }
.sync-pill {
  display: flex; align-items: center; gap: 5px;
  font-size: 11px; color: var(--text3);
  background: var(--surface2);
  padding: 4px 10px; border-radius: 20px;
}
.sync-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-mid); flex-shrink: 0; }
.sync-dot.spin { background: var(--amber); animation: blink .8s infinite; }
.sync-dot.err { background: var(--red); }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.2} }

/* ── Scroll area ── */
.scroll-area {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16px 16px calc(80px + var(--safe-bottom));
}

/* ── Bottom tab bar ── */
.tabbar {
  background: var(--surface);
  border-top: 1px solid var(--border);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding-bottom: var(--safe-bottom);
  position: sticky;
  bottom: 0;
  z-index: 100;
}
.tabbar-item {
  display: flex; flex-direction: column; align-items: center; gap: 3px;
  padding: 10px 4px;
  font-size: 10px; color: var(--text3);
  cursor: pointer; border: none; background: none;
  transition: color .15s;
}
.tabbar-item.on { color: var(--green); }
.tabbar-icon { font-size: 22px; line-height: 1; }

/* ── Section ── */
.sec { display: none; }
.sec.on { display: block; }

/* ── Cards ── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px;
  margin-bottom: 12px;
}
.card-title {
  font-size: 12px; font-weight: 600;
  color: var(--text3); text-transform: uppercase;
  letter-spacing: .05em; margin-bottom: 12px;
}

/* ── Stats ── */
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
.stat { background: var(--surface2); border-radius: var(--rs); padding: 12px; }
.stat-lbl { font-size: 11px; color: var(--text3); margin-bottom: 4px; }
.stat-val { font-size: 16px; font-weight: 600; }
.stat-sub { font-size: 11px; color: var(--text3); margin-top: 3px; line-height: 1.5; }

/* ── Meal cards ── */
.meal {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
  margin-bottom: 10px;
}
.meal-hd {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
}
.badge { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
.b-m { background: var(--blue-bg); color: var(--blue); }
.b-s { background: var(--amber-bg); color: var(--amber); }
.b-f { background: var(--green-bg); color: var(--green); }
.meal-t { font-size: 11px; color: var(--text3); }
.meal-body { padding: 10px 14px; }
.meal-row {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding: 5px 0; border-bottom: 1px solid var(--border);
}
.meal-row:last-child { border: none; }
.meal-name { font-size: 14px; }
.meal-amt { font-size: 11px; color: var(--text3); text-align: right; max-width: 140px; line-height: 1.4; }
.meal-note {
  font-size: 11px; color: var(--text3);
  padding: 8px 14px 12px;
  border-top: 1px solid var(--border);
  line-height: 1.6;
}

/* ── Buttons ── */
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 9px 16px;
  border: 1px solid var(--border2);
  border-radius: var(--rs);
  background: var(--surface);
  font-size: 14px; color: var(--text);
  cursor: pointer; font-family: inherit;
  transition: background .1s;
  -webkit-tap-highlight-color: transparent;
}
.btn:active { background: var(--surface2); transform: scale(.98); }
.btn-g { background: var(--green-bg); color: var(--green); border-color: rgba(59,109,17,.25); }
.btn-g:active { background: #d2eab0; }
.btn-full { width: 100%; justify-content: center; }
.btn-sm { padding: 5px 11px; font-size: 12px; }

/* ── Forms ── */
.fg { display: flex; flex-direction: column; gap: 5px; }
.fg label { font-size: 12px; font-weight: 500; color: var(--text2); }
.fg-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
.fg-full { grid-column: 1/-1; }
input[type=text], input[type=date], select, textarea {
  padding: 10px 12px;
  border: 1px solid var(--border2);
  border-radius: var(--rs);
  background: var(--surface2);
  color: var(--text);
  font-size: 14px;
  font-family: inherit;
  width: 100%;
  outline: none;
  -webkit-appearance: none;
  appearance: none;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--green);
  background: var(--surface);
}
textarea { resize: none; min-height: 72px; }

/* ── Chips ── */
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  font-size: 12px; padding: 4px 12px;
  border-radius: 20px; cursor: default;
}
.chip-ok { background: var(--green-bg); color: var(--green); }
.chip-warn { background: var(--amber-bg); color: var(--amber); }
.chip-fail { background: var(--red-bg); color: var(--red); }
.chip-pending { background: var(--surface2); color: var(--text3); }

/* ── Timeline ── */
.tl { padding-left: 16px; }
.tl-item {
  position: relative;
  padding: 0 0 16px 16px;
  border-left: 1px solid var(--border);
}
.tl-item:last-child { border-left-color: transparent; }
.tl-dot {
  position: absolute; left: -5px; top: 4px;
  width: 9px; height: 9px; border-radius: 50%;
  background: var(--border2);
  border: 2px solid var(--surface);
}
.tl-dot.active { background: var(--amber); }
.tl-dot.done { background: var(--green); }
.tl-date { font-size: 11px; color: var(--text3); }
.tl-name { font-size: 14px; font-weight: 500; margin-top: 2px; }
.tl-desc { font-size: 12px; color: var(--text2); margin-top: 2px; }

/* ── Log entries ── */
.log-item {
  display: flex; gap: 10px; padding: 12px 0;
  border-bottom: 1px solid var(--border);
  align-items: flex-start;
}
.log-item:last-child { border: none; }
.log-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; }
.log-body { flex: 1; min-width: 0; }
.log-meta { font-size: 11px; color: var(--text3); margin-bottom: 3px; }
.log-foods { font-size: 14px; line-height: 1.5; }
.log-note { font-size: 12px; color: var(--text2); margin-top: 3px; line-height: 1.5; }
.log-tag {
  display: inline-block; font-size: 10px; padding: 2px 8px;
  border-radius: 20px; margin-top: 4px;
}
.who-tag {
  display: inline-block; font-size: 10px; padding: 2px 8px;
  border-radius: 20px;
  background: var(--blue-bg); color: var(--blue);
  margin-left: 4px;
}
.del-btn {
  background: none; border: none; color: var(--text3);
  font-size: 18px; cursor: pointer; padding: 0 4px;
  flex-shrink: 0; line-height: 1;
}

/* ── Calendar ── */
.cal-nav {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 14px;
}
.cal-nav-btn {
  background: var(--surface2); border: none; border-radius: var(--rs);
  width: 34px; height: 34px; font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--text);
}
.cal-nav-btn:active { background: var(--border); }
.cal-month { font-size: 16px; font-weight: 600; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-dow { text-align: center; font-size: 11px; color: var(--text3); padding: 4px 0; font-weight: 500; }
.cal-day {
  aspect-ratio: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border-radius: var(--rs); cursor: pointer;
  font-size: 14px; position: relative;
  -webkit-tap-highlight-color: transparent;
}
.cal-day:active { background: var(--surface2); }
.cal-day.today { border: 2px solid var(--green); font-weight: 700; }
.cal-day.has-log { background: var(--green-bg); color: var(--green); font-weight: 600; }
.cal-day.other { color: var(--text3); }
.cal-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--green); margin-top: 2px;
}

/* ── Toast ── */
.toast-wrap {
  position: fixed; bottom: calc(80px + var(--safe-bottom) + 12px);
  left: 50%; transform: translateX(-50%);
  z-index: 999; pointer-events: none;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.toast {
  background: rgba(26,25,22,.88);
  color: #fff; padding: 10px 18px;
  border-radius: 20px; font-size: 13px;
  white-space: nowrap;
  opacity: 0; transform: translateY(8px);
  transition: all .2s;
}
.toast.show { opacity: 1; transform: translateY(0); }

/* ── Empty state ── */
.empty { text-align: center; padding: 32px 0; color: var(--text3); font-size: 14px; }

/* ── Allergy group ── */
.allergy-group { margin-bottom: 16px; }
.allergy-group-title {
  font-size: 12px; font-weight: 600; color: var(--text2);
  margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
}

/* ── Section header ── */
.sec-hd { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
.sec-hd-t { font-size: 20px; font-weight: 600; }
.sec-hd-s { font-size: 12px; color: var(--text3); margin-top: 3px; }

/* ── Cycle override buttons ── */
.cycle-btns { display: flex; gap: 6px; margin-top: 10px; }
.cycle-btn {
  flex: 1; padding: 5px 0; font-size: 11px;
  border: 1px solid var(--border2); border-radius: 6px;
  background: none; cursor: pointer; color: var(--text2);
  font-family: inherit;
}
.cycle-btn:active { background: var(--surface2); }

/* ── Install banner ── */
.install-banner {
  display: none;
  background: var(--green-bg);
  border: 1px solid rgba(59,109,17,.2);
  border-radius: var(--r);
  padding: 12px 16px;
  margin-bottom: 12px;
  align-items: center;
  gap: 10px;
}
.install-banner.show { display: flex; }
.install-banner-text { flex: 1; font-size: 13px; color: var(--green); line-height: 1.5; }
</style>
</head>
<body>

<!-- Top bar -->
<div class="topbar">
  <div>
    <div class="topbar-title">🥣 宝宝辅食</div>
    <div class="topbar-sub" id="baby-age">宝宝 7个月17天</div>
  </div>
  <div class="sync-pill">
    <div class="sync-dot spin" id="sync-dot"></div>
    <span id="sync-msg">连接中</span>
  </div>
</div>

<!-- Scroll area -->
<div class="scroll-area" id="scroll-area">

  <!-- ═══ TODAY ═══ -->
  <div class="sec on" id="sec-today">

    <div id="install-banner" class="install-banner">
      <div class="install-banner-text">📲 添加到主屏幕，像 App 一样使用！</div>
      <button class="btn btn-sm btn-g" onclick="dismissInstall()">知道了</button>
    </div>

    <div class="sec-hd">
      <div>
        <div class="sec-hd-t" id="today-heading">今日菜单</div>
        <div class="sec-hd-s" id="today-date-sub">加载中…</div>
      </div>
      <button class="btn btn-sm" onclick="genMenu()">🔀 换一份</button>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-lbl">今日蛋白质</div>
        <div class="stat-val" id="s-protein">—</div>
      </div>
      <div class="stat">
        <div class="stat-lbl">轮换阶段</div>
        <div class="stat-val" id="s-cycle-type">—</div>
        <div class="stat-sub" id="s-cycle-tip">—</div>
        <div class="cycle-btns">
          <button class="cycle-btn" onclick="overrideType('meat')">🥩 今日改肉类</button>
          <button class="cycle-btn" onclick="overrideType('seafood')">🐟 今日改鱼虾</button>
        </div>
      </div>
      <div class="stat">
        <div class="stat-lbl">已排敏</div>
        <div class="stat-val" id="s-done">—</div>
      </div>
      <div class="stat">
        <div class="stat-lbl">下次排敏</div>
        <div class="stat-val" id="s-next" style="font-size:13px;margin-top:2px">—</div>
      </div>
    </div>

    <div id="menu-wrap"></div>

    <div class="card">
      <div class="card-title">今日注意</div>
      <div style="font-size:13px;color:var(--text2);line-height:2">
        🔥 食材蒸熟至软烂，手指食物以牙龈可压碎为准<br>
        👀 手指食物全程看护，宝宝坐直，不强迫进食<br>
        📝 新引入食材观察 48–72 小时，记录皮肤和消化反应<br>
        🫒 核桃油每餐 3–4 滴加入正餐，不单独喂食
      </div>
    </div>
  </div>

  <!-- ═══ ALLERGY ═══ -->
  <div class="sec" id="sec-allergy">
    <div class="sec-hd">
      <div>
        <div class="sec-hd-t">排敏管理</div>
        <div class="sec-hd-s">每 3 天引入一种新食物</div>
      </div>
      <button class="btn btn-sm btn-g" onclick="toggleAllergyForm()">+ 记录</button>
    </div>

    <div class="card" id="allergy-form-card" style="display:none;border-color:rgba(59,109,17,.3)">
      <div class="card-title">新排敏记录</div>
      <div class="fg-row">
        <div class="fg"><label>食材名称</label><input type="text" id="af-name" placeholder="如：小白菜"></div>
        <div class="fg"><label>分类</label>
          <select id="af-cat">
            <option value="主食类">主食类</option>
            <option value="肉蛋类">肉蛋类</option>
            <option value="蔬菜类" selected>蔬菜类</option>
            <option value="调味辅料">调味辅料</option>
            <option value="坚果类">坚果类</option>
          </select>
        </div>
        <div class="fg"><label>开始日期</label><input type="date" id="af-date"></div>
        <div class="fg"><label>反应结果</label>
          <select id="af-result">
            <option value="ok">✅ 无反应，通过</option>
            <option value="warn">⚠️ 轻微反应，观察</option>
            <option value="fail">❌ 有反应，暂停</option>
          </select>
        </div>
        <div class="fg fg-full"><label>备注</label><input type="text" id="af-note" placeholder="如：接受度好，大便正常"></div>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-g" onclick="saveAllergy()">保存</button>
        <button class="btn" onclick="toggleAllergyForm()">取消</button>
      </div>
    </div>

    <div class="card">
      <div class="card-title">已排敏食材</div>
      <div id="allergy-cleared"></div>
    </div>

    <div class="card">
      <div class="card-title">待排敏计划</div>
      <div class="tl" id="pending-tl"></div>
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text3);line-height:1.9">
        🔒 贝类、蟹类、蜂蜜 → 满 1 岁后<br>
        🔒 水果类 → 满 1 岁后
      </div>
    </div>
  </div>

  <!-- ═══ LOG ═══ -->
  <div class="sec" id="sec-log">
    <div class="sec-hd">
      <div>
        <div class="sec-hd-t">饮食记录</div>
        <div class="sec-hd-s">全家共同查看和记录</div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">新增记录</div>
      <div class="fg-row">
        <div class="fg"><label>日期</label><input type="date" id="lf-date"></div>
        <div class="fg"><label>记录人</label><input type="text" id="lf-who" placeholder="妈妈 / 奶奶 / 爸爸"></div>
        <div class="fg"><label>餐次</label>
          <select id="lf-meal">
            <option value="main">🍽️ 上午正餐</option>
            <option value="snack">🍪 下午点心</option>
            <option value="finger">✋ 傍晚手指食物</option>
          </select>
        </div>
        <div class="fg"><label>进食情况</label>
          <select id="lf-reaction">
            <option value="ok">✅ 正常无反应</option>
            <option value="warn">⚠️ 轻微异常</option>
            <option value="alert">❌ 有明显反应</option>
          </select>
        </div>
        <div class="fg fg-full"><label>食材内容</label>
          <input type="text" id="lf-foods" placeholder="如：猪肉泥 20g、南瓜 25g、米粉糊 15g…">
        </div>
        <div class="fg fg-full"><label>备注</label>
          <textarea id="lf-note" placeholder="进食量、宝宝反应、偏好…"></textarea>
        </div>
      </div>
      <button class="btn btn-g btn-full" onclick="saveLog()">💾 保存记录</button>
    </div>

    <div class="card">
      <div class="card-title" style="display:flex;justify-content:space-between">
        历史记录
        <span id="log-count" style="font-weight:400;color:var(--text3)">0 条</span>
      </div>
      <div id="log-list"><div class="empty">暂无记录，快去添加第一条～</div></div>
    </div>
  </div>

  <!-- ═══ CALENDAR ═══ -->
  <div class="sec" id="sec-cal">
    <div class="sec-hd">
      <div>
        <div class="sec-hd-t">日历</div>
        <div class="sec-hd-s">绿色日期有记录，点击查看</div>
      </div>
    </div>

    <div class="card">
      <div class="cal-nav">
        <button class="cal-nav-btn" onclick="calMove(-1)">‹</button>
        <span class="cal-month" id="cal-label">2026年5月</span>
        <button class="cal-nav-btn" onclick="calMove(1)">›</button>
      </div>
      <div class="cal-grid" style="margin-bottom:4px">
        <div class="cal-dow">日</div><div class="cal-dow">一</div>
        <div class="cal-dow">二</div><div class="cal-dow">三</div>
        <div class="cal-dow">四</div><div class="cal-dow">五</div>
        <div class="cal-dow">六</div>
      </div>
      <div class="cal-grid" id="cal-grid"></div>
      <div style="display:flex;gap:12px;margin-top:12px;font-size:11px;color:var(--text3)">
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:12px;height:12px;border-radius:3px;background:var(--green-bg);border:1px solid rgba(59,109,17,.2);display:inline-block"></span>有记录
        </span>
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:12px;height:12px;border-radius:3px;border:2px solid var(--green);display:inline-block"></span>今天
        </span>
      </div>
    </div>

    <div class="card" id="cal-detail" style="display:none">
      <div class="card-title" id="cal-detail-title">详情</div>
      <div id="cal-detail-body"></div>
    </div>
  </div>

</div>

<!-- Bottom tab bar -->
<div class="tabbar">
  <button class="tabbar-item on" onclick="nav('today')" id="tab-today">
    <span class="tabbar-icon">🍽️</span>今日菜单
  </button>
  <button class="tabbar-item" onclick="nav('allergy')" id="tab-allergy">
    <span class="tabbar-icon">✅</span>排敏
  </button>
  <button class="tabbar-item" onclick="nav('log')" id="tab-log">
    <span class="tabbar-icon">📝</span>记录
  </button>
  <button class="tabbar-item" onclick="nav('cal')" id="tab-cal">
    <span class="tabbar-icon">📅</span>日历
  </button>
</div>

<!-- Toast container -->
<div class="toast-wrap" id="toast-wrap">
  <div class="toast" id="toast"></div>
</div>

<script>
// ═══════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════
const API = '/api/data';

const DEFAULT = {
  settings:{ birthdate:'2025-10-07', startdate:'2026-04-07', proteinOverride:{} },
  allergyDone:[
    {name:'米粉',cat:'主食类',date:'2026-04-07',result:'ok',note:'首个辅食'},
    {name:'面条',cat:'主食类',date:'2026-04-20',result:'ok',note:''},
    {name:'猪肉',cat:'肉蛋类',date:'2026-04-23',result:'ok',note:''},
    {name:'鸡肉',cat:'肉蛋类',date:'2026-04-26',result:'ok',note:''},
    {name:'牛肉',cat:'肉蛋类',date:'2026-04-29',result:'ok',note:''},
    {name:'鳕鱼',cat:'肉蛋类',date:'2026-05-02',result:'ok',note:''},
    {name:'海虾',cat:'肉蛋类',date:'2026-05-05',result:'ok',note:''},
    {name:'蛋黄',cat:'肉蛋类',date:'2026-05-08',result:'ok',note:''},
    {name:'西兰花',cat:'蔬菜类',date:'2026-05-02',result:'ok',note:''},
    {name:'胡萝卜',cat:'蔬菜类',date:'2026-05-05',result:'ok',note:''},
    {name:'菠菜',cat:'蔬菜类',date:'2026-05-08',result:'ok',note:''},
    {name:'番茄',cat:'蔬菜类',date:'2026-05-11',result:'ok',note:''},
    {name:'豌豆',cat:'蔬菜类',date:'2026-05-14',result:'ok',note:''},
    {name:'南瓜',cat:'蔬菜类',date:'2026-05-17',result:'ok',note:''},
    {name:'黑芝麻',cat:'调味辅料',date:'2026-05-14',result:'ok',note:''},
    {name:'核桃油',cat:'调味辅料',date:'2026-04-10',result:'ok',note:'每餐3-4滴'},
  ],
  allergyPending:[
    {name:'叶菜类（小白菜、生菜…）',cat:'蔬菜类',planDate:'2026-05-25',note:'叶酸和铁来源'},
    {name:'花菜类（紫甘蓝…）',cat:'蔬菜类',planDate:'2026-05-28',note:''},
    {name:'茄果类（茄子…）',cat:'蔬菜类',planDate:'2026-05-31',note:''},
    {name:'荚果类（扁豆、毛豆…）',cat:'蔬菜类',planDate:'2026-06-03',note:''},
    {name:'瓜果类（丝瓜、冬瓜…）',cat:'蔬菜类',planDate:'2026-06-06',note:''},
    {name:'菌类（香菇、口蘑…）',cat:'蔬菜类',planDate:'2026-06-09',note:'富含维生素D'},
    {name:'水生蔬菜（莲藕…）',cat:'蔬菜类',planDate:'2026-06-12',note:''},
    {name:'猪肝',cat:'肉蛋类',planDate:'2026-06-15',note:'富含铁，每周1次'},
    {name:'其他鱼类（三文鱼…）',cat:'肉蛋类',planDate:'2026-06-18',note:''},
  ],
  logs:[],
  fingerFoods:[
    {name:'南瓜条',note:'蒸至软烂，切手指粗细长条'},
    {name:'胡萝卜条',note:'蒸熟软烂，牙龈可压碎'},
    {name:'西兰花小朵',note:'蒸软，去硬茎'},
    {name:'番茄瓣',note:'去皮去籽，切大块'},
    {name:'牛肉软条',note:'炖至极软，顺纹切长条'},
    {name:'猪肉软块',note:'蒸炖至软烂，切厚片'},
    {name:'鸡肉条',note:'煮熟撕成粗条'},
    {name:'米糕条',note:'米粉蒸成糕，切条'},
  ]
};

let D = JSON.parse(JSON.stringify(DEFAULT));
let saveTimer = null;

// ─── API ───
async function loadData() {
  setSyncState('loading','连接中…');
  try {
    const r = await fetch(API);
    const j = await r.json();
    if (j.ok && j.data) {
      D = Object.assign({}, DEFAULT, j.data, {
        settings: Object.assign({}, DEFAULT.settings, (j.data.settings||{}))
      });
      setSyncState('ok','已同步');
    } else {
      setSyncState('ok','首次使用，已载入默认数据');
    }
  } catch(e) {
    // 离线或API未配置，用本地默认
    const local = localStorage.getItem('bfdata');
    if (local) { try { D = JSON.parse(local); } catch(_){} }
    setSyncState('warn','离线模式（数据仅存本地）');
  }
  renderAll();
}

function scheduleSave() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(doSave, 800);
}

async function doSave() {
  setSyncState('loading','保存中…');
  localStorage.setItem('bfdata', JSON.stringify(D));
  try {
    const r = await fetch(API, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({data: D})
    });
    const j = await r.json();
    if (j.ok) {
      setSyncState('ok','已保存·全家同步');
      const now = new Date();
      document.getElementById('sync-msg').textContent =
        `${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')} 已同步`;
    } else throw new Error();
  } catch(e) {
    setSyncState('warn','离线，已存本地');
  }
}

function setSyncState(state, msg) {
  const dot = document.getElementById('sync-dot');
  dot.className = 'sync-dot' + (state==='loading'?' spin':state==='err'?' err':'');
  document.getElementById('sync-msg').textContent = msg;
}

// ─── Helpers ───
function todayStr() { return new Date().toISOString().split('T')[0]; }
function fmtDate(d) {
  if(!d) return '';
  const dt = new Date(d+'T00:00:00');
  return `${dt.getMonth()+1}月${dt.getDate()}日`;
}
function pick(arr, n) {
  let pool=[...arr], out=[];
  n = n||1;
  for(let i=0;i<n;i++){
    if(!pool.length) break;
    let idx=Math.floor(Math.random()*pool.length);
    out.push(pool.splice(idx,1)[0]);
  }
  return n===1 ? out[0] : out;
}
function getBabyAge() {
  const birth = new Date(D.settings.birthdate+'T00:00:00');
  const days = Math.floor((new Date()-birth)/86400000);
  const m = Math.floor(days/30.44), r = Math.floor(days-m*30.44);
  return `${m}个月${r}天`;
}
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2200);
}

// ─── Protein rotation ───
const MEATS = ['猪肉','鸡肉','牛肉'];
const SEAFOODS = ['鳕鱼','海虾','三文鱼','鲈鱼'];
function getDone(cat, filter) {
  return D.allergyDone.filter(f => f.cat===cat && f.result==='ok' && (!filter||filter(f.name))).map(f=>f.name);
}
function getProteinType() {
  const ov = D.settings.proteinOverride||{};
  if (ov[todayStr()]) return ov[todayStr()];
  const start = new Date(D.settings.startdate+'T00:00:00');
  const days = Math.floor((new Date()-start)/86400000);
  return ((days%6)+6)%6 < 3 ? 'meat' : 'seafood';
}
function getCycleInfo() {
  const start = new Date(D.settings.startdate+'T00:00:00');
  const days = Math.floor((new Date()-start)/86400000);
  const pos = ((days%6)+6)%6;
  const type = getProteinType();
  const dayInPhase = (pos%3)+1;
  const daysLeft = 3-dayInPhase;
  return {type, dayInPhase, daysLeft};
}
function overrideType(t) {
  if (!D.settings.proteinOverride) D.settings.proteinOverride={};
  D.settings.proteinOverride[todayStr()] = t;
  scheduleSave();
  genMenu();
  toast(t==='meat'?'已切换为今日肉类':'已切换为今日鱼虾');
}

// ─── Menu ───
function genMenu() {
  const meats = getDone('肉蛋类', n=>MEATS.some(k=>n.includes(k)));
  const seafoods = getDone('肉蛋类', n=>SEAFOODS.some(k=>n.includes(k)));
  const vegs = getDone('蔬菜类');
  const starches = getDone('主食类');
  const nuts = D.allergyDone.filter(f=>(f.cat==='调味辅料'||f.cat==='坚果类')&&f.result==='ok'&&f.name!=='核桃油').map(f=>f.name);

  const ptype = getProteinType();
  const info = getCycleInfo();
  let protein = ptype==='meat'
    ? (meats.length?pick(meats):'猪肉')
    : (seafoods.length?pick(seafoods):(meats.length?pick(meats):'鳕鱼'));
  const veg = vegs.length?pick(vegs):'西兰花';
  const starch = starches.length?pick(starches):'米粉';
  const nut = nuts.length?pick(nuts):'黑芝麻';
  const fingers = D.fingerFoods.length>=2?pick(D.fingerFoods,2):D.fingerFoods;

  const pLabel = protein.replace(/肉$/,'肉泥').replace(/虾$/,'虾泥').replace(/鱼$/,'鱼泥');
  const sLabel = starch==='面条'?'面条碎':starch+'糊';
  const nLabel = nut.includes('油')?nut:nut+'酱';

  document.getElementById('s-protein').textContent = protein;
  document.getElementById('s-cycle-type').textContent = ptype==='meat'?'🥩 肉类':'🐟 鱼虾';
  document.getElementById('s-cycle-tip').textContent =
    `第${info.dayInPhase}天${info.daysLeft===0?'，明日切换':`，还剩${info.daysLeft}天`}`;
  document.getElementById('s-done').innerHTML =
    D.allergyDone.filter(f=>f.result==='ok').length + '<span style="font-size:12px;color:var(--text3)"> 种</span>';

  const np = D.allergyPending[0];
  document.getElementById('s-next').textContent = np ? np.name.split('（')[0] : '暂无';

  const now = new Date();
  const days=['日','一','二','三','四','五','六'];
  document.getElementById('today-heading').textContent =
    `${now.getMonth()+1}月${now.getDate()}日 · 今日菜单`;
  document.getElementById('today-date-sub').textContent =
    `宝宝 ${getBabyAge()} · 周${days[now.getDay()]}`;
  document.getElementById('baby-age').textContent = `宝宝 ${getBabyAge()}`;

  document.getElementById('menu-wrap').innerHTML = `
    <div class="meal">
      <div class="meal-hd"><span class="badge b-m">上午正餐</span><span class="meal-t">约 10:00</span></div>
      <div class="meal-body">
        <div class="meal-row"><span class="meal-name">${sLabel}</span><span class="meal-amt">15–20 g</span></div>
        <div class="meal-row"><span class="meal-name">${pLabel}</span><span class="meal-amt">20–25 g</span></div>
        <div class="meal-row"><span class="meal-name">${veg}（泥/碎）</span><span class="meal-amt">25 g</span></div>
        <div class="meal-row"><span class="meal-name">蛋黄</span><span class="meal-amt">半个</span></div>
        <div class="meal-row"><span class="meal-name">核桃油</span><span class="meal-amt">3–4 滴</span></div>
      </div>
      <div class="meal-note">分别蒸熟打泥混合，最后加核桃油。</div>
    </div>
    <div class="meal">
      <div class="meal-hd"><span class="badge b-s">下午点心</span><span class="meal-t">约 15:00</span></div>
      <div class="meal-body">
        <div class="meal-row"><span class="meal-name">${nLabel}</span><span class="meal-amt">3–5 g</span></div>
        <div class="meal-row"><span class="meal-name">${starch==='面条'?'面条碎':starch+'糊'}（稀薄）</span><span class="meal-amt">5–10 g</span></div>
      </div>
      <div class="meal-note">坚果酱与米粉糊混合调顺滑后喂食。</div>
    </div>
    <div class="meal">
      <div class="meal-hd"><span class="badge b-f">傍晚手指食物</span><span class="meal-t">约 17:30</span></div>
      <div class="meal-body">
        ${fingers.map(f=>`<div class="meal-row"><span class="meal-name">${f.name}</span><span class="meal-amt">${f.note}</span></div>`).join('')}
      </div>
      <div class="meal-note">全程看护，鼓励自主抓握。</div>
    </div>`;
}

// ─── Allergy ───
function renderAllergy() {
  const byCat = {};
  D.allergyDone.forEach(f => {
    if (!byCat[f.cat]) byCat[f.cat]=[];
    byCat[f.cat].push(f);
  });
  const icons={'主食类':'🌾','肉蛋类':'🥩','蔬菜类':'🥦','调味辅料':'🫙','坚果类':'🥜'};
  let html='';
  Object.keys(byCat).forEach(cat=>{
    html+=`<div class="allergy-group"><div class="allergy-group-title">${icons[cat]||'🍴'} ${cat}</div><div class="chips">`;
    byCat[cat].forEach(f=>{
      const cls=f.result==='ok'?'chip-ok':f.result==='warn'?'chip-warn':'chip-fail';
      const ic=f.result==='ok'?'✓':f.result==='warn'?'⚠':'✗';
      html+=`<span class="chip ${cls}" title="${fmtDate(f.date)}${f.note?' · '+f.note:''}">${ic} ${f.name}</span>`;
    });
    html+='</div></div>';
  });
  document.getElementById('allergy-cleared').innerHTML = html||'<div class="empty">暂无记录</div>';

  const now=new Date();
  let tlHtml='';
  D.allergyPending.forEach((item,i)=>{
    const isNext=i===0;
    const isPast=new Date(item.planDate+'T00:00:00')<=now;
    tlHtml+=`<div class="tl-item">
      <div class="tl-dot ${isNext?'active':isPast?'done':''}"></div>
      <div class="tl-date">${fmtDate(item.planDate)} 起，排敏 3 天</div>
      <div class="tl-name">${isNext?'👉 ':''}${item.name}</div>
      ${item.note?`<div class="tl-desc">${item.note}</div>`:''}
    </div>`;
  });
  document.getElementById('pending-tl').innerHTML = tlHtml||'<div class="empty">待排敏计划已完成！</div>';
}

function toggleAllergyForm() {
  const c=document.getElementById('allergy-form-card');
  const show=c.style.display==='none';
  c.style.display=show?'block':'none';
  if (show) {
    document.getElementById('af-date').value=todayStr();
    document.getElementById('af-name').focus();
  }
}
function saveAllergy() {
  const name=document.getElementById('af-name').value.trim();
  if(!name){toast('请填写食材名称');return;}
  D.allergyDone.push({
    name,
    cat: document.getElementById('af-cat').value,
    date: document.getElementById('af-date').value,
    result: document.getElementById('af-result').value,
    note: document.getElementById('af-note').value.trim()
  });
  const idx=D.allergyPending.findIndex(p=>p.name.includes(name)||name.includes(p.name.split('（')[0]));
  if(idx>=0) D.allergyPending.splice(idx,1);
  scheduleSave();
  toggleAllergyForm();
  document.getElementById('af-name').value='';
  document.getElementById('af-note').value='';
  renderAllergy();
  genMenu();
  toast(`✅ 已记录：${name}`);
}

// ─── Logs ───
function renderLogs() {
  const ml={'main':'🍽️ 正餐','snack':'🍪 点心','finger':'✋ 手指食物'};
  const mc={'main':'#185FA5','snack':'#854F0B','finger':'#3B6D11'};
  const rl={'ok':'✅ 无反应','warn':'⚠️ 轻微异常','alert':'❌ 有反应'};
  const rc={'ok':['var(--green-bg)','var(--green)'],'warn':['var(--amber-bg)','var(--amber)'],'alert':['var(--red-bg)','var(--red)']};
  document.getElementById('log-count').textContent = D.logs.length+' 条';
  if(!D.logs.length){
    document.getElementById('log-list').innerHTML='<div class="empty">暂无记录，快去添加～</div>';
    return;
  }
  document.getElementById('log-list').innerHTML=D.logs.map(l=>`
    <div class="log-item">
      <div class="log-dot" style="background:${mc[l.meal]||'#185FA5'}"></div>
      <div class="log-body">
        <div class="log-meta">${fmtDate(l.date)} · ${ml[l.meal]||l.meal}${l.who?`<span class="who-tag">${l.who}</span>`:''}</div>
        <div class="log-foods">${l.foods}</div>
        ${l.note?`<div class="log-note">${l.note}</div>`:''}
        <span class="log-tag" style="background:${(rc[l.reaction]||rc.ok)[0]};color:${(rc[l.reaction]||rc.ok)[1]}">${rl[l.reaction]||''}</span>
      </div>
      <button class="del-btn" onclick="delLog(${l.id})">×</button>
    </div>`).join('');
}
function saveLog() {
  const foods=document.getElementById('lf-foods').value.trim();
  const date=document.getElementById('lf-date').value;
  if(!foods||!date){toast('请填写日期和食材');return;}
  D.logs.unshift({
    id:Date.now(), date,
    who: document.getElementById('lf-who').value.trim(),
    meal: document.getElementById('lf-meal').value,
    foods, reaction: document.getElementById('lf-reaction').value,
    note: document.getElementById('lf-note').value.trim()
  });
  scheduleSave();
  document.getElementById('lf-foods').value='';
  document.getElementById('lf-note').value='';
  renderLogs();
  toast('✅ 记录已保存');
}
function delLog(id) {
  if(!confirm('确认删除这条记录？')) return;
  D.logs=D.logs.filter(l=>l.id!==id);
  scheduleSave();
  renderLogs();
}

// ─── Calendar ───
let calY=new Date().getFullYear(), calM=new Date().getMonth();
function renderCal() {
  const mns=['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
  document.getElementById('cal-label').textContent=calY+'年'+mns[calM];
  const logDates=new Set(D.logs.map(l=>l.date));
  const first=new Date(calY,calM,1).getDay();
  const days=new Date(calY,calM+1,0).getDate();
  const ts=todayStr();
  let html='';
  for(let i=0;i<first;i++) html+='<div></div>';
  for(let d=1;d<=days;d++){
    const ds=`${calY}-${String(calM+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const hasLog=logDates.has(ds), isToday=ds===ts;
    html+=`<div class="cal-day${hasLog?' has-log':''}${isToday?' today':''}" onclick="showCalDay('${ds}')">${d}
      ${hasLog?'<div class="cal-dot"></div>':''}
    </div>`;
  }
  document.getElementById('cal-grid').innerHTML=html;
}
function calMove(d){
  calM+=d;
  if(calM<0){calM=11;calY--;}
  if(calM>11){calM=0;calY++;}
  renderCal();
  document.getElementById('cal-detail').style.display='none';
}
function showCalDay(ds) {
  const entries=D.logs.filter(l=>l.date===ds);
  const det=document.getElementById('cal-detail');
  if(!entries.length){det.style.display='none';return;}
  const ml={'main':'🍽️ 正餐','snack':'🍪 点心','finger':'✋ 手指食物'};
  document.getElementById('cal-detail-title').textContent=fmtDate(ds)+' 的记录';
  document.getElementById('cal-detail-body').innerHTML=entries.map(l=>`
    <div style="padding:10px 0;border-bottom:1px solid var(--border)">
      <div style="font-size:12px;color:var(--text3);margin-bottom:3px">${ml[l.meal]||l.meal}${l.who?' · '+l.who:''}</div>
      <div style="font-size:14px">${l.foods}</div>
      ${l.note?`<div style="font-size:12px;color:var(--text2);margin-top:3px">${l.note}</div>`:''}
    </div>`).join('');
  det.style.display='block';
}

// ─── Navigation ───
function nav(name) {
  document.querySelectorAll('.sec').forEach(s=>s.classList.remove('on'));
  document.querySelectorAll('.tabbar-item').forEach(b=>b.classList.remove('on'));
  document.getElementById('sec-'+name).classList.add('on');
  document.getElementById('tab-'+name).classList.add('on');
  document.getElementById('scroll-area').scrollTop=0;
  if(name==='allergy') renderAllergy();
  if(name==='log'){ document.getElementById('lf-date').value=todayStr(); renderLogs(); }
  if(name==='cal') renderCal();
}

function renderAll() { genMenu(); renderAllergy(); renderLogs(); renderCal(); }

// ─── PWA install prompt ───
let deferredPrompt = null;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  const banner = document.getElementById('install-banner');
  if (!localStorage.getItem('installDismissed')) {
    banner.classList.add('show');
  }
});
function dismissInstall() {
  document.getElementById('install-banner').classList.remove('show');
  localStorage.setItem('installDismissed','1');
}

// ─── Service Worker ───
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(()=>{});
}

// ─── Init ───
document.getElementById('lf-date').value = todayStr();
loadData();
</script>
</body>
</html>
